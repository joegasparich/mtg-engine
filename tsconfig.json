{
    "compilerOptions": {
        "experimentalDecorators": true,
        "target": "ESNext",
        "module": "esnext",
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "noImplicitAny": true,
        "strict": false,
        "sourceMap": true,
        "inlineSources": true,

        "paths": {
            "~/*": ["./src/*"],
            "@engine/*": ["./src/engine/*"],
            "@utility/*": ["./src/utility/*"],
            "@ui/*": ["./src/ui/*"]
        },
        "outDir": "dist",
        "moduleResolution": "bundler",
        "resolveJsonModule": true,
        "useDefineForClassFields": false,
        "types": [
            "vite/client",
            "vitest/globals",
        ]
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
