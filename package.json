{
    "name": "mtg-engine",
    "productName": "mtg-engine",
    "version": "1.0.0",
    "description": "An experimental Magic: The Gathering engine with an Electron and PixiJS interface",
    "main": ".vite/build/main.cjs",
    "scripts": {
        "start": "electron-forge start",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "publish": "electron-forge publish",
        "test": "vitest",
        "lint": "eslint .",
        "tsc:watch": "tsc --noEmit --watch",
        "start:debug": "electron-forge start -- --inspect=9229 --remote-debugging-port=9223",
        "test:run": "vitest run",
        "typecheck": "tsc --noEmit",
        "check": "npm run typecheck && npm run lint && npm run test:run"
    },
    "keywords": [],
    "author": {
        "name": "Joe Gasparich",
        "email": "joe.gasparich@gmail.com"
    },
    "license": "MIT",
    "devDependencies": {
        "@electron-forge/cli": "^8.0.1",
        "@electron-forge/maker-deb": "^8.0.1",
        "@electron-forge/maker-rpm": "^8.0.1",
        "@electron-forge/maker-squirrel": "^8.0.1",
        "@electron-forge/maker-zip": "^8.0.1",
        "@electron-forge/plugin-fuses": "^8.0.1",
        "@electron-forge/plugin-vite": "^8.0.1",
        "@electron/fuses": "^2.1.3",
        "@eslint/js": "^10.0.0",
        "@types/electron-squirrel-startup": "^1.0.2",
        "@types/node": "^24.0.0",
        "electron": "45.4.1",
        "eslint": "^10.15.0",
        "globals": "^17.0.0",
        "typescript": "~6.0.0",
        "typescript-eslint": "^8.74.0",
        "vite": "^8.3.8",
        "vitest": "^4.1.12"
    },
    "dependencies": {
        "electron-squirrel-startup": "^1.0.1",
        "pixi-filters": "^6.1.2",
        "pixi.js": "^8.9.2",
        "uuid": "^14.0.3"
    },
    "engines": {
        "node": ">=22.17.0"
    }
}
