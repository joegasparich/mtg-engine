{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug browser app",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}"
    },
    {
      "name": "Debug tests",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": [
        "run",
        "--no-file-parallelism"
      ],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true
    }
  ]
}
